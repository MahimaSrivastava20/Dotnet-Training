@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<link rel="stylesheet" href="~/css/employee.css" />

<div class="form-wrapper">
    <div class="form-card">
        <h2 class="form-title">Employee Registration</h2>

        <form asp-action="Create" method="post">

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="Id"></label>
                    <input asp-for="Id" type="number" class="form-control" />
                    <span asp-validation-for="Id" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" pattern="[A-Za-z ]+" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Address"></label>
                    <textarea asp-for="Address" rows="2" class="form-control"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AadhaarCard"></label>
                    <input asp-for="AadhaarCard" maxlength="12" pattern="\d{12}" class="form-control" />
                    <span asp-validation-for="AadhaarCard" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DOB"></label>
                    <input asp-for="DOB"
                           type="date"
                           class="form-control"
                           max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="DOB" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Salary"></label>
                    <input asp-for="Salary" type="number" min="10000" class="form-control" />
                    <span asp-validation-for="Salary" class="text-danger"></span>
                </div>

            </div>

            <button type="submit" class="btn-save">Save Employee</button>

        </form>

        <a asp-action="Index" class="back-link">← View All Employees</a>
    </div>
</div>