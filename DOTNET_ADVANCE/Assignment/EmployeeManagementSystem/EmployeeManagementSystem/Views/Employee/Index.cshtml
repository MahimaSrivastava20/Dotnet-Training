@model List<EmployeeManagementSystem.Models.Employee>

@{
    ViewData["Title"] = "Employee List";
}

<link rel="stylesheet" href="~/css/employee.css" />

<div class="table-container">

    <h2>Employee List</h2>

    <a asp-action="Create" class="btn-add">+ Add New Employee</a>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Address</th>
                <th>Aadhaar</th>
                <th>DOB</th>
                <th>Salary</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var emp in Model)
                {
                    <tr>
                        <td>@emp.Id</td>
                        <td>@emp.Name</td>
                        <td>@emp.Address</td>
                        <td>@emp.AadhaarCard</td>
                        <td>@emp.DOB.ToShortDateString()</td>
                        <td>₹ @emp.Salary</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">No employees found.</td>
                </tr>
            }
        </tbody>
    </table>

</div>